# ---------------------------------------------------------------------------
# 3dHome - example environment file.
#
# Copy to .env and edit:   cp .env.example .env
# .env is gitignored. This file is not, so it must never contain a real
# hostname or a real token - every value below is a placeholder.
#
# docker-compose reads .env automatically. For a non-container deploy, export
# these and run deploy/generate-config.sh by hand:
#
#     set -a; . ./.env; set +a
#     sh deploy/generate-config.sh /var/www/home3d
#
# EVERY VARIABLE IS OPTIONAL. With none of them set the app boots into the
# demo house with Home Assistant disabled, which is a working app - just not a
# connected one.
# ---------------------------------------------------------------------------


# --- Home Assistant connection ---------------------------------------------

# Base URL of your Home Assistant instance, as reachable from the BROWSER that
# loads the page - not from inside the container. Include the scheme and, if
# it is not 443/80, the port.
#
# Leave empty to run without Home Assistant: the house renders, the lights are
# simply static.
HOME3D_HA_URL=https://homeassistant.example.com

# Optional second URL, tried when HOME3D_HA_URL is unreachable. The usual case
# is a VPN or mesh-network hostname for when you are away from the LAN.
#
# NOTE: this is ignored entirely when the page is loaded with a ?haUrl=
# parameter. An embedder that names an origin explicitly gets that origin and
# no other - see docs/configuration.md.
HOME3D_HA_FALLBACK_URL=

# A Home Assistant long-lived access token.
# Create one at: your HA profile page -> Security -> Long-lived access tokens.
#
# ####################################################################
# #  READ THIS. This token is written into config.js, which is       #
# #  served to EVERY browser that can load the page. Anyone who can  #
# #  reach the app can read the token and use it against your Home   #
# #  Assistant with the full privileges of the user who issued it.   #
# #                                                                  #
# #  Only deploy this app behind authentication - a VPN, a mesh      #
# #  network, an authenticating reverse proxy, or a LAN-only         #
# #  listener. Do not expose it to the public internet.              #
# #                                                                  #
# #  Reduce the blast radius: create a DEDICATED Home Assistant user #
# #  with only the access this app needs, issue the token as that    #
# #  user, and rotate it periodically.                               #
# ####################################################################
HOME3D_HA_TOKEN=

# Force Home Assistant on or off, overriding the default inference.
# Leave unset (recommended) and it is enabled when BOTH HOME3D_HA_URL and
# HOME3D_HA_TOKEN are non-empty, and disabled otherwise.
#
# Accepts true/false, 1/0, yes/no, on/off. Setting it true without a URL and a
# token does NOT enable it - that configuration cannot work, so it is refused
# with a warning rather than deferred into a runtime failure.
# HOME3D_HA_ENABLED=


# --- The house -------------------------------------------------------------

# Which profile under houses/ to render. Default: demo.
#
# The demo house is the fictional one committed to this repo. Your own house is
# a directory you create - see docs/configuration.md and houses/demo/README.md.
# Keep a real house OUT of this repo: bind-mount it, as docker-compose.yml
# shows, so its geometry and entity ids are never committed anywhere public.
HOME3D_HOUSE=demo


# --- Timings ---------------------------------------------------------------

# Delay in milliseconds before retrying a dropped Home Assistant websocket.
HOME3D_WS_RECONNECT_MS=5000

# REST poll interval in milliseconds, used when the websocket is unavailable.
HOME3D_POLL_INTERVAL_MS=5000


# --- Embedding -------------------------------------------------------------

# Which origins may embed this app in an iframe, as a CSP frame-ancestors
# source list. SET THIS if anything embeds the app cross-origin - a dashboard
# tile, a Home Assistant view - because the default blocks it.
#
# Default: 'self' (same-origin embedding only; never a wildcard).
#
# Space-separated, quote the whole value, and keep the single quotes around
# 'self' - they are part of CSP syntax, not shell quoting:
#
#   HOME3D_FRAME_ANCESTORS="'self' https://dashboard.example.com https://homeassistant.example.com"
#
# X-Frame-Options is deliberately never sent by this app. It has no allow-list
# form, so setting it would break every cross-origin embed; frame-ancestors is
# the header that can express "these origins and nobody else".
HOME3D_FRAME_ANCESTORS="'self'"


# --- Version ---------------------------------------------------------------

# Stamped into the visible version badge and into every ?v= cache-busting query
# string in index.html at container start, replacing the __VERSION__
# placeholder. One value, one source, so the badge and the asset URLs cannot
# drift apart.
#
# Unset falls back to "dev". In CI this is passed as a Docker build arg from
# the release tag.
APP_VERSION=dev


# --- Container-only --------------------------------------------------------

# Host port to publish the container's port 80 on.
HOME3D_PORT=8080
