    },
    "kitchen": {
      "main": ["light.demo_kitchen_ceiling"],
      "ambient": ["light.demo_kitchen_undercupboard"]
    },
    "study": {
      "main": ["light.demo_study_spots"],
      "ambient": ["light.demo_study_desk_strip"]
    },
    "hall": {
      "main": ["light.demo_hall_ceiling"]
    },
    "store": {
      "main": ["light.demo_store_bulb"]
    },
    "bathroom": {
      "main": ["light.demo_bathroom_ceiling"]
    },
    "bedroom": {
      "main": ["light.demo_bedroom_spots"],
      "ambient": ["light.demo_bedroom_bedside"]
    }
