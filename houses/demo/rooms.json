{
  "kind": "rooms",
  "schemaVersion": "1.0",
  "house": "demo",
  "homeAssistant": {
    "enabled": false,
    "wsReconnectMs": 5000,
    "pollIntervalMs": 5000
  },
  "rooms": {
    "lounge": {
      "main": ["light.demo_lounge_ceiling"],
