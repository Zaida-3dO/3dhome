{
  "kind": "rooms",
  "schemaVersion": "1.9",
  "house": "demo",
  "homeAssistant": {
    "enabled": false,
    "wsReconnectMs": 5000,
    "pollIntervalMs": 5000
  },
  "rooms": {
    "lounge": {
      "main": ["light.demo_lounge_ceiling"],
      "ambient": ["light.demo_lounge_cove"]
    },
    "kitchen": {
      "main": ["light.demo_kitchen_ceiling"],
      "ambient": ["light.demo_kitchen_undercupboard"]
    },
    "study": {
      "main": ["light.demo_study_spots"],
      "ambient": ["light.demo_study_desk_strip"]
    },
    "hall": {
      "main": ["light.demo_hall_ceiling"]
    },
    "store": {
      "main": ["light.demo_store_bulb"]
    },
    "bathroom": {
      "main": ["light.demo_bathroom_ceiling"]
    },
    "bedroom": {
      "main": ["light.demo_bedroom_spots"],
      "ambient": ["light.demo_bedroom_bedside"]
    }
  },
  "sensors": {
    "presence": {
      "lounge": ["binary_sensor.demo_lounge_occupancy", "binary_sensor.demo_lounge_sofa_zone"],
      "kitchen": ["binary_sensor.demo_kitchen_motion"],
      "study": ["binary_sensor.demo_study_occupancy"],
      "hall": ["binary_sensor.demo_hall_motion"]
    },
    "doors": {
      "front_door": ["binary_sensor.demo_front_door_contact"],
      "store_door": ["binary_sensor.demo_store_door_contact"],
      "bedroom_door": ["binary_sensor.demo_bedroom_door_contact"]
    },
    "curtains": {
      "lounge_curtain": ["cover.demo_lounge_curtain"],
      "lounge_sheer": ["cover.demo_lounge_sheer"],
      "bedroom_curtain": ["cover.demo_bedroom_curtain"]
    },
    "corniceLights": {
      "lounge_curtain": ["light.demo_lounge_cornice"],
      "bedroom_curtain": ["light.demo_bedroom_cornice"]
    },
    "climate": {
      "lounge": "climate.demo_lounge_thermostat",
      "kitchen": "climate.demo_kitchen_radiator",
      "study": "climate.demo_study_radiator",
      "hall": "climate.demo_hall_radiator",
      "bathroom": "climate.demo_bathroom_radiator",
      "bedroom": "climate.demo_bedroom_radiator"
    },
    "vacuums": {
      "kitchen_robot": {
        "entity": "vacuum.demo_robot",
        "battery": "sensor.demo_robot_battery_level",
        "segments": { "kitchen": 1, "lounge": 2, "hall": 3 }
      }
    },
    "plants": {
      "lounge_corn_plant": {
        "moisture": "sensor.demo_corn_plant_soil_moisture",
        "battery": "sensor.demo_corn_plant_battery",
        "temperature": "sensor.demo_corn_plant_temperature"
      },
      "bedroom_snake_plant": {
        "moisture": "sensor.demo_snake_plant_soil_moisture",
        "status": "binary_sensor.demo_snake_plant_dry",
        "dryBelow": 15
      },
      "kitchen_peace_lily": {
        "moisture": "sensor.demo_peace_lily_soil_moisture",
        "battery": "sensor.demo_peace_lily_battery_state"
      },
      "study_ficus": {
        "moisture": "sensor.demo_ficus_soil_moisture"
      },
      "hall_jade": {
        "watering": "sensor.demo_jade_watering_countdown"
      }
    },
    "items": {
      "bedroom_tv": {
        "media": [
          {
            "entity": "media_player.demo_bedroom_tv",
            "label": "TV",
            "role": "tv"
          },
          {
            "entity": "media_player.demo_bedroom_tv_cast",
            "label": "TV cast",
            "role": "cast"
          }
        ]
      },
      "bedroom_tv_console": [
        {
          "title": "Console cupboard",
          "region": {
            "from": 0,
            "to": 50
          },
          "readings": [
            {
              "entity": "sensor.demo_router_temperature",
              "label": "Router",
              "humidity": "sensor.demo_router_humidity"
            },
            {
              "entity": "sensor.demo_media_server_temperature",
              "label": "Media server",
              "humidity": "sensor.demo_media_server_humidity"
            },
            {
              "entity": "sensor.demo_games_console_temperature",
              "label": "Games console",
              "humidity": "sensor.demo_games_console_humidity"
            }
          ]
        },
        {
          "title": "Sound system",
          "region": {
            "from": 50,
            "to": 130
          },
          "media": [
            {
              "entity": "media_player.demo_receiver",
              "label": "Receiver",
              "role": "receiver"
            },
            {
              "entity": "media_player.demo_receiver_cast",
              "label": "Receiver cast",
              "role": "cast"
            }
          ],
          "readings": [
            {
              "entity": "sensor.demo_receiver_shelf_temperature",
              "label": "Shelf",
              "humidity": "sensor.demo_receiver_shelf_humidity"
            }
          ]
        }
      ],
      "bedroom_bedside": {
        "title": "Bedside lights",
        "lights": [
          {
            "entity": "light.demo_bedside_drawers",
            "label": "All drawers"
          },
          {
            "entity": "light.demo_bedside_top",
            "label": "Top drawer"
          },
          {
            "entity": "light.demo_bedside_bottom",
            "label": "Bottom drawer"
          }
        ]
      },
      "store_crate": {
        "title": "Store camera",
        "cameras": [
          {
            "entity": "camera.demo_store",
            "label": "Store",
            "refreshMs": 2000
          }
        ]
      },
      "study_desk": {
        "title": "Desk",
        "switches": [
          {
            "entity": "switch.demo_desk_monitor",
            "label": "Monitor",
            "power": "sensor.demo_desk_monitor_power"
          },
          {
            "entity": "switch.demo_desk_charger",
            "label": "Charger",
            "power": "sensor.demo_desk_charger_power"
          }
        ]
      }
    },
    "roomScripts": {
      "lounge": { "entity": "script.demo_room_off", "variables": { "area": "demo_lounge_kitchen" } },
      "kitchen": { "entity": "script.demo_room_off", "variables": { "area": "demo_lounge_kitchen" } },
      "hall": { "entity": "script.demo_room_off", "variables": { "area": "demo_hall_store" } },
      "store": { "entity": "script.demo_room_off", "variables": { "area": "demo_hall_store" } },
      "study": { "entity": "script.demo_room_off", "variables": { "area": "demo_study" } },
      "bathroom": { "entity": "script.demo_room_off", "variables": { "area": "demo_bathroom" } },
      "bedroom": { "entity": "script.demo_room_off", "variables": { "area": "demo_bedroom" }, "label": "Switch room off" }
    }
  }
}
